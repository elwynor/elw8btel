/* Build 26.10.19.1 11:10PM */
/* ELW8BTEL.rc - Windows version resource for the 8Ball module DLL.          */
/* Keep the numbers in step with ELW8BTEL_VER_* and ELW8BTEL_VERSION        */
/* (E8_DEFS.H).                                                              */

#include <winver.h>

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_DLL
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Elwynor Technologies"
            VALUE "FileDescription",  "8Ball for Teleconference - Magic 8-Ball for The Major BBS v10"
            VALUE "FileVersion",      "1.0.0.0"
            VALUE "InternalName",     "ELW8BTEL"
            VALUE "LegalCopyright",   "Copyright (c) 2026 Elwynor Technologies. Originally HOTELeconference 8Ball by Randall R. Spangler, annex.com."
            VALUE "OriginalFilename", "ELW8BTEL.DLL"
            VALUE "ProductName",      "8Ball for Teleconference"
            VALUE "ProductVersion",   "1.0.0"
            VALUE "Comments",         "8Ball converted for The Major BBS v10 by Mark Laudenbach - https://github.com/laudenbachm"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
